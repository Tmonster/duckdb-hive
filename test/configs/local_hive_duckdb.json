{
  "description": "Hive catalogs over the metastore kept in a DuckDB database, with the tables on the local file system: no servers needed",
  "statically_loaded_extensions": [
    "core_functions",
    "parquet",
    "json",
    "hive"
  ],
  "test_env": [
    {
      "env_name": "HIVE_TEST_CONFIG",
      "env_value": "duckdb"
    },
    {
      "env_name": "HIVE_METASTORE_URI",
      "env_value": "{TEST_DIR}/metastore.duckdb"
    },
    {
      "env_name": "HIVE_WAREHOUSE",
      "env_value": "{TEST_DIR}/warehouse"
    }
  ],
  "skip_tests": [],
  "skip_error_messages": []
}
