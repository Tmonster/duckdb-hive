# name: test/sql/hive.test
# description: test hive extension
# group: [sql]

# Before we load the extension, this will fail
statement error
SELECT hive('Sam');
----
Catalog Error: Scalar Function with name hive does not exist!

# Require statement will ensure this test is run with this extension loaded
require hive

# Confirm the extension works
query I
SELECT hive('Sam');
----
...........🦆 Sam

query I
SELECT hive_openssl_version('Michael') ILIKE 'Hive Michael, my linked OpenSSL version is OpenSSL%';
----
true
